ShooterCalculations shooterCalcs = new ShooterCalculations(
    40.0,   // MIN_HOOD_ANGLE - your value
    60.0,   // MAX_HOOD_ANGLE - your value
    0.2,    // MIN_SERVO_POSITION - your value
    0.8,    // MAX_SERVO_POSITION - your value
    1.5,    // FLYWHEEL_SLOPE - from Excel
    100.0   // FLYWHEEL_INTERCEPT - from Excel
);

// 2. In your main loop:
while (opModeIsActive()) {

    // Get robot position from Pinpoint
    double robotX = /* your pinpoint X */;
    double robotY = /* your pinpoint Y */;
    double robotVelX = /* your pinpoint velocity X */;
    double robotVelY = /* your pinpoint velocity Y */;

    // Calculate shooting parameters
    ShooterCalculations.ShootingParameters params =
        shooterCalcs.calculateShootingParameters(
            robotX,              // inches
            robotY,              // inches
            robotVelX,           // in/s
            robotVelY,           // in/s
            72.0,                // goal X
            72.0,                // goal Y
            24.0,                // goal height
            Math.toRadians(-45), // entry angle
            Math.toRadians(40),  // min hood angle
            Math.toRadians(60)   // max hood angle
        );

    // Apply to hardware
    hoodServo.setPosition(params.hoodServoPosition);
    flywheelMotor1.setVelocity(params.flywheelSpeed);
    flywheelMotor2.setVelocity(params.flywheelSpeed);

    // YOU control turret manually
    double turretPos = 0.5 + gamepad1.left_stick_x * 0.5;
    turretServo1.setPosition(turretPos);
    turretServo2.setPosition(turretPos);
}

